# MinIO（コミュニティ版）の起動設定
# 使い方: cp .env.example .env して編集する（.env はコミットしない）．
#   ./run.sh start / podman compose up -d --build のどちらも .env を読む．
#   優先順位: シェルの環境変数 > .env > 既定値．./run.sh config で実際の値を確認できる．
# 書式: KEY=VALUE（1行1変数）．値の中の ${VAR} は使わない（run.sh は展開しない）．
# 以下の値はすべて既定値．変えない行はコメントアウトしたままでもよい．

# コンテナランタイム（podman / docker）．run.sh のみ（compose は実行したコマンドで決まる）
CONTAINER_RUNTIME=podman

# ビルドする公式リポジトリ github.com/minio/minio のタグ（RELEASE.YYYY-MM-DDThh-mm-ssZ 形式）．
# Dockerfile のビルド引数として渡し，イメージタグ localhost/handbook-minio:<タグ> にも使う
MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z

# run.sh が起動に使うイメージ．run.sh のみ．空なら localhost/handbook-minio:$MINIO_VERSION．
# キャッシュ済みの公式イメージ等を使う場合に指定する（例: quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z）
MINIO_IMAGE=

# ホスト側のポート（S3 API / Web コンソール）
MINIO_S3_PORT=9000
MINIO_CONSOLE_PORT=9001

# ルートユーザーの認証情報（S3 のアクセスキー / シークレットとしても使う）．
# minioadmin は既知のダミー値なので，localhost 以外へ公開する場合は必ず変更すること
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
