# RustFS の起動設定
# 使い方: cp .env.example .env して編集する（.env はコミットしない）．
#   ./run.sh start / podman compose up -d のどちらも .env を読む．
#   優先順位: シェルの環境変数 > .env > 既定値．./run.sh config で実際の値を確認できる．
# 書式: KEY=VALUE（1行1変数）．値の中の ${VAR} は使わない（run.sh は展開しない）．
# 以下の値はすべて既定値．

# コンテナランタイム（podman / docker）．run.sh のみ（compose は実行したコマンドで決まる）
CONTAINER_RUNTIME=podman

# 使用するイメージ
RUSTFS_IMAGE=docker.io/rustfs/rustfs:1.0.5

# ホスト側のポート（S3 API / Web コンソール）
RUSTFS_S3_PORT=9020
RUSTFS_CONSOLE_PORT=9021

# 管理者の認証情報（S3 のアクセスキー / シークレットとしても使う．空だと起動しない）．
# rustfsadmin は既知のダミー値で，公式も使わないよう明記している．
# localhost 以外へ公開する場合は必ず変更すること（例: openssl rand -base64 24）
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
