# SeaweedFS の起動設定
# 使い方: cp .env.example .env して編集する（.env はコミットしない）．
#   ./run.sh start / podman compose up -d のどちらも .env を読む．
#   優先順位: シェルの環境変数 > .env > 既定値．./run.sh config で実際の値を確認できる．
# 書式: KEY=VALUE（1行1変数）．値の中の ${VAR} は使わない（run.sh は展開しない）．
# 以下の値はすべて既定値．

# コンテナランタイム（podman / docker）．run.sh のみ（compose は実行したコマンドで決まる）
CONTAINER_RUNTIME=podman

# 使用するイメージ
SEAWEEDFS_IMAGE=docker.io/chrislusf/seaweedfs:4.53

# ホスト側のポート（S3 API / 管理UI / master UI / filer UI）
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_ADMIN_PORT=12535
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_FILER_PORT=8888

# 管理UIのパスワード（ユーザー名は admin）．未設定だと管理UIがホストから開けないため必須．
# admin は既知のダミー値なので，localhost 以外へ公開する場合は必ず変更すること
SEAWEEDFS_ADMIN_PASSWORD=admin

# S3 の認証情報を定義する設定ファイル．相対パスはこのディレクトリ基準（run.sh / compose 共通）．
# 同梱の s3.json のキーもダミー値なので，公開する場合は書き換えたファイルを指定すること
SEAWEEDFS_S3_CONFIG=./s3.json
