# MinIO AIStor（商用版）の起動設定
# 使い方: cp .env.example .env して編集する（.env はコミットしない）．
#   ./run.sh start / podman compose up -d のどちらも .env を読む．
#   優先順位: シェルの環境変数 > .env > 既定値．./run.sh config で実際の値を確認できる．
# 書式: KEY=VALUE（1行1変数）．値の中の ${VAR} は使わない（run.sh は展開しない）．
# 以下の値はすべて既定値．

# コンテナランタイム（podman / docker）．run.sh のみ（compose は実行したコマンドで決まる）
CONTAINER_RUNTIME=podman

# 使用するイメージ
AISTOR_IMAGE=quay.io/minio/aistor/minio:RELEASE.2026-09-19T17-05-25Z

# ライセンスファイルのパス．相対パスはこのディレクトリ基準（run.sh / compose 共通）
AISTOR_LICENSE_FILE=./minio.license

# ホスト側のポート（S3 API / Web コンソール）
AISTOR_S3_PORT=9010
AISTOR_CONSOLE_PORT=9011

# ルートユーザーの認証情報（コンテナには MINIO_ROOT_USER / MINIO_ROOT_PASSWORD として渡す）．
# minioadmin は既知のダミー値なので，localhost 以外へ公開する場合は必ず変更すること
AISTOR_ROOT_USER=minioadmin
AISTOR_ROOT_PASSWORD=minioadmin
