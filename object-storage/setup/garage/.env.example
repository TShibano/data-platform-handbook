# Garage の起動設定
# 使い方: cp .env.example .env して編集する（.env はコミットしない）．
#   ./run.sh start / podman compose up -d のどちらも .env を読む．
#   優先順位: シェルの環境変数 > .env > 既定値．./run.sh config で実際の値を確認できる．
# 書式: KEY=VALUE（1行1変数）．値の中の ${VAR} は使わない（run.sh は展開しない）．
# 以下の値はすべて既定値．
#
# 注意: このファイル（.env）は起動設定の「入力」．run.sh start が書き出す .garage_env は
# 生成された S3 認証情報の「出力」で，別物（source して AWS CLI 等で使う）．

# コンテナランタイム（podman / docker）．run.sh のみ（compose は実行したコマンドで決まる）
CONTAINER_RUNTIME=podman

# 使用するイメージ
GARAGE_IMAGE=docker.io/dxflrs/garage:v2.5.0

# ホスト側のポート（S3 API / 静的 Web 公開 / Admin API）
GARAGE_S3_PORT=3900
GARAGE_WEB_PORT=3902
GARAGE_ADMIN_PORT=3903

# --- run.sh のみ（CLI で初期化する） ---
# レイアウトに登録する容量（実際の上限ではなくデータ配置の重み）
GARAGE_CAPACITY=10G
# 作成するキーの名前（キー ID / シークレットは Garage が生成し .garage_env に書き出す）
GARAGE_KEY_NAME=handbook-key
# 作成するバケット名
GARAGE_BUCKET=handbook

# --- compose のみ（--single-node --default-bucket で自動初期化する） ---
# 既定キーの ID（8文字以上の英数字と -_.）とシークレット（16文字以上の印字可能 ASCII）．
# 既知のダミー値なので，localhost 以外へ公開する場合は必ず変更すること
GARAGE_DEFAULT_ACCESS_KEY=GKhandbook0000000000000000
GARAGE_DEFAULT_SECRET_KEY=handbook-garage-secret-change-me
# 自動作成するバケット名
GARAGE_DEFAULT_BUCKET=handbook
