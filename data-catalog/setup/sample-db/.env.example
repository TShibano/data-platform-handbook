# サンプル DB（PostgreSQL）の起動設定
# 使い方: cp .env.example .env して編集する（.env はコミットしない）．
#   ./run.sh start / podman compose up -d のどちらも .env を読む．
#   優先順位: シェルの環境変数 > .env > 既定値．./run.sh config で実際の値を確認できる．
# 書式: KEY=VALUE（1行1変数）．値の中の ${VAR} は使わない（run.sh は展開しない）．
# 以下の値はすべて既定値．
#
# ポート（5432）と接続情報（sampledb / sample_user / sample_password）は変えられない．
# OpenMetadata / DataHub の recipe（configs/ 配下）に同じ値を書いているため．

# 使用するイメージ
SAMPLE_DB_IMAGE=docker.io/library/postgres:16-alpine

# ./run.sh start が初期化 SQL の完了を待つ秒数
SAMPLE_DB_START_TIMEOUT=120
