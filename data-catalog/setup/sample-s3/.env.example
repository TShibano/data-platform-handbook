# サンプル S3（MinIO）の起動設定
# 使い方: cp .env.example .env して編集する（.env はコミットしない）．
#   ./run.sh start / podman compose up -d のどちらも .env を読む．
#   優先順位: シェルの環境変数 > .env > 既定値．./run.sh config で実際の値を確認できる．
# 書式: KEY=VALUE（1行1変数）．値の中の ${VAR} は使わない（run.sh は展開しない）．
# 以下の値はすべて既定値．
#
# ポート（9100 / 9101），認証情報（sample_s3_user / sample_s3_password），バケット名（sample-lake）は変えられない．
# OpenMetadata / DataHub のインジェスト定義（configs/ 配下）に同じ値を書いているため．

# MinIO のバージョン（公式リポジトリ github.com/minio/minio のタグ）．
# object-storage/setup/minio の Dockerfile でビルドし，localhost/handbook-minio:<タグ> として使う
SAMPLE_S3_MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z

# ./run.sh start が MinIO の応答を待つ秒数
SAMPLE_S3_START_TIMEOUT=60
