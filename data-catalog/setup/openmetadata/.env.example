# OpenMetadata の起動設定
# 使い方: cp .env.example .env して編集する（.env はコミットしない）．
#   ./run.sh は .env を読み，compose にも --env-file で同じファイルを渡す．
#   優先順位: シェルの環境変数 > .env > 既定値．./run.sh config で実際の値を確認できる．
# 書式: KEY=VALUE（1行1変数）．値の中の ${VAR} は使わない（run.sh は展開しない）．
# 以下の値はすべて既定値．
#
# ここに無い upstream compose（compose.upstream.yml）の変数（SMTP_* など）も，
# .env に書けば compose に渡る（run.sh 自体は使わない．config では「compose.yaml 専用」と表示される）．

# DataHub と同時起動するときだけ 1 にする（両スタックは 8080 / 9200 / 3306 で衝突する）．
# 1 にすると compose.altports.yml を重ね，mysql は 13306，elasticsearch は 19200/19300，
# ingestion (Airflow) は 18080 に変わる．openmetadata-server の 8585/8586 は変わらない．
# ポート番号そのものは .env では変えられない（compose.override.yml の `ports: !override`
# にリテラルで書いてある．podman-compose 1.6.0 が !override タグ内の ${VAR} を展開しないため）．
OM_ALT_PORTS=0

# 使用するイメージ（upstream compose の ${OPENMETADATA_*_IMAGE} に渡る）．
# upstream の既定は docker.getcollate.io/openmetadata/*:2.0.0 だが，このミラーは匿名 pull の
# 制限が厳しく実機で "toomanyrequests" になった（Docker Hub 本体の匿名枠は枯れておらず，
# docker.getcollate.io 固有の制限）．同一イメージが docker.io/openmetadata/* にも公開されており，
# 2.0.1 タグが arm64 にも対応しているため，そちらを既定にしている．
# タグを変えるときは Containerfile.ingestion の FROM / pip のバージョンも揃えること．
OPENMETADATA_DB_IMAGE=docker.io/openmetadata/db:2.0.1
OPENMETADATA_SERVER_IMAGE=docker.io/openmetadata/server:2.0.1
OPENMETADATA_INGESTION_IMAGE=docker.io/openmetadata/ingestion:2.0.1

# ./run.sh ingest が ingestion-bot の JWT を取得するためにログインする管理者．
# サーバ側の初期値（admin@open-metadata.org / admin）を変えるものではない．
# UI でパスワードを変えた場合に，ここも合わせて変える．
OM_ADMIN_EMAIL=admin@open-metadata.org
OM_ADMIN_PASSWORD=admin

# ./run.sh start が UI の応答を待つ秒数（初回はイメージ pull とマイグレーションで数分かかる）
OM_START_TIMEOUT=600
