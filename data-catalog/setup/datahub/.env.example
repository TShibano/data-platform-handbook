# DataHub の起動設定
# 使い方: cp .env.example .env して編集する（.env はコミットしない）．
#   ./run.sh は .env を読み，compose にも --env-file で同じファイルを渡す．
#   優先順位: シェルの環境変数 > .env > 既定値．./run.sh config で実際の値を確認できる．
# 書式: KEY=VALUE（1行1変数）．値の中の ${VAR} は使わない（run.sh は展開しない）．
# 以下の値はすべて既定値．

# OpenMetadata と同時起動するときだけ 1 にする（両スタックは 8080 / 9200 / 3306 で衝突する）．
# 1 にすると compose.altports.yml を重ね，mysql は 23306，opensearch は 29200，gms は 28080 に変わる．
# frontend-quickstart の 9002 は変わらない．ingest も start と同じ値で実行すること（GMS のポートが変わるため）．
# ポート番号そのものは .env では変えられない（compose.override.yml の `ports: !override`
# にリテラルで書いてある．podman-compose 1.6.0 が !override タグ内の ${VAR} を展開しないため）．
# 同じ理由で，upstream の DATAHUB_MAPPED_GMS_PORT / DATAHUB_MAPPED_FRONTEND_PORT も効かない．
DATAHUB_ALT_PORTS=0

# イメージタグ（upstream compose の image: acryldata/datahub-gms:${DATAHUB_VERSION} 等に入る）．
# acryldata の Docker Hub タグは v 接頭辞付きなので v1.7.0 と書く（v なしだと manifest unknown で pull に失敗する）．
# upstream compose の取得元（run.sh の DATAHUB_RELEASE，v なし）とは別物．上げるときは両方揃える．
DATAHUB_VERSION=v1.7.0

# UI からインジェストを実行するときに使われる acryl-datahub（PyPI）のバージョン．PyPI 表記なので v なし．
# Containerfile.ingestion の pip install のバージョンとも揃えること．
UI_INGESTION_DEFAULT_CLI_VERSION=1.7.0

# トークンサービスの salt / signing key．
# 既定値はこのローカル検証環境専用の固定値で，本番相当の利用では必ずランダム値に変える
# （例: openssl rand -hex 32）．公式 quickstart は実行のたびにランダム生成するが，
# ここでは何度 up/down してもトークンの検証結果が変わらないよう固定値にしている．
# 変えると，発行済みのアクセストークンは使えなくなる．
DATAHUB_TOKEN_SERVICE_SALT=local-lab-not-a-secret-salt-9f2c7a1d
DATAHUB_TOKEN_SERVICE_SIGNING_KEY=local-lab-not-a-secret-signing-key-3e81b4c0

# ./run.sh start が UI の応答を待つ秒数（system-update の完了待ちがあり OpenMetadata より遅い）
DATAHUB_START_TIMEOUT=900
